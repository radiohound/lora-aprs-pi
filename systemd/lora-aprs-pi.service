[Unit]
Description=LoRa APRS Pi station
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
# Runs as root: it needs SPI, GPIO, port 80 and NetworkManager control.
WorkingDirectory=/opt/lora-aprs-pi
ExecStart=/usr/bin/python3 -m lora_aprs_pi --config /etc/lora-aprs-pi/config.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
